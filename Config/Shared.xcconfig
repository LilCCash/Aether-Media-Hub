// Shared build settings. Override per developer in Config/Signing.local.xcconfig (git-ignored):
//   DEVELOPMENT_TEAM = ABCDE12345
//   APP_BUNDLE_ID = com.yourname.aether
APP_BUNDLE_ID = app.aether.mediahub
DEVELOPMENT_TEAM =
MARKETING_VERSION = 1.3.0
// Pre-release label shown in Settings > Informazioni; it is not part of the version number iOS compares.
AETHER_RELEASE_LABEL = Beta 1
CURRENT_PROJECT_VERSION = 1
#include? "Signing.local.xcconfig"
